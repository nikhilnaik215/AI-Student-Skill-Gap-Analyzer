# =============================================================================
# Git Ignore Configuration for AI-Student-Skill-Gap-Analyzer
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secret Files
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# -----------------------------------------------------------------------------
# Node.js & Frontend (React / Vite)
# -----------------------------------------------------------------------------
node_modules/
*/node_modules/
dist/
frontend/dist/
dist-ssr/
build/
frontend/build/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Java & Maven (Spring Boot Backend)
# -----------------------------------------------------------------------------
target/
backend/target/
*/target/
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper / temp files
.mvn/wrapper/maven-wrapper.jar

# Java crash logs & dumps
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Logs & Databases
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
*.sqlite
*.db

# -----------------------------------------------------------------------------
# IDE & Editor Configurations
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/nbdist/
.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Operating System & Temporary Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Temporary / Swap files
*.tmp
*.bak
*.swp
*.swo
*~
